# Copy this file to .env and fill in one or both of the next two lines.

# Bot token from the Discord Developer Portal. Posts in every server the bot is in.
DISCORD_BOT_TOKEN=

# Webhook URL of one channel. Posts in that channel only.
DISCORD_WEBHOOK_URL=

# Optional settings
# CHANNEL_NAME=brutal-combo
# CHECK_MINUTES=5
# SKIP_CATEGORIES=Rumor,Business
