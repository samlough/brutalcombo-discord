{
  // Cloudflare Worker settings. Cloudflare reads this file on every deploy.
  "name": "brutalcombo-discord",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // Check for new stories every two minutes.
  "triggers": {
    "crons": ["*/2 * * * *"]
  },

  // Storage for connected channels and the list of posted stories.
  // The id is not secret; it only works inside the owning Cloudflare account.
  "kv_namespaces": [
    { "binding": "STATE", "id": "8a2af5b2c48949eb97bc5450c58dfb92" }
  ],

  // Not secret. The matching secret, DISCORD_CLIENT_SECRET, is set in the
  // Cloudflare dashboard and never appears in this repository.
  "vars": {
    "DISCORD_CLIENT_ID": "1572135220398923826",
    "FEED_URL": "https://brutalcombo.com/feed.xml",
    // The picture shown on every post. It is the logo.png file in this repository.
    "POST_AVATAR_URL": "https://raw.githubusercontent.com/samlough/brutalcombo-discord/main/logo.png"
  },

  "observability": {
    "enabled": true
  }
}
